# Web research
TAVILY_API_KEY=tvly-your-key

# Recommended production LLM route: public HTTPS endpoint of your OWN
# OmniRoute deployment. Keep /v1 at the end and protect the server with a key.
OMNIROUTE_BASE_URL=https://llm.example.com/v1
OMNIROUTE_API_KEY=sk-your-omniroute-key
OMNIROUTE_MODEL=auto

# Optional local fallback when OMNIROUTE_BASE_URL is intentionally unset.
# GROQ_API_KEY=gsk_your-key
# GROQ_MODEL=openai/gpt-oss-120b
